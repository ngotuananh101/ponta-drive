# Ponta Drive Frontend Environment Configuration

# Optional API Base URL
# Leave empty in local development to automatically use Vite's proxy to http://127.0.0.1:3000
# In production on Cloudflare Pages or Vercel, set this to your backend server URL, e.g.:
# VITE_API_BASE_URL=https://api.ponta.vn
VITE_API_BASE_URL=

# Cloudflare Pages Build Environment Variables:
# BUN_VERSION=1.4.2

